# Postgres
POSTGRES_USER=taskworked
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskworked

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# MinIO (S3-compatible object storage, used for task attachments)
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=taskworked
# Host a browser can reach for attachment downloads — leave unset for
# local Docker Compose (defaults to localhost:9000); set to your public
# domain:9000 in production.
MINIO_PUBLIC_ENDPOINT=

# AI Assistant (Claude API)
ANTHROPIC_API_KEY=

# Email (SMTP) — used for password reset and notification digests
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LINE Notify
LINE_NOTIFY_TOKEN=

# Rate limiting (in-memory, per API process — see docker-compose comment if
# you ever run multiple API replicas). Defaults are sane; override only if
# you have a specific reason to.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW=1m
# Stricter limit on /auth/register, /auth/login, /auth/refresh specifically —
# this is what blunts credential-stuffing/brute-force attempts.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1m

# Frontend static site port on the host
WEB_PORT=80

# Backup service (Postgres + MinIO) — see docs/operations/backup-recovery.md.
# All of these are optional; defaults are safe for local dev. The IMPORTANT one
# for production is BACKUP_ENCRYPTION_PASSPHRASE — set it before going live.
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14
# Encrypts Postgres dumps at rest with AES-256 (openssl). Leave unset for local
# dev; set to a long random value in production — generate with:
#   openssl rand -base64 32
BACKUP_ENCRYPTION_PASSPHRASE=
# Optional: any HTTP endpoint that accepts a JSON POST (internal alerting relay,
# etc.) — receives {"status":"ok"|"fail","message":...} after every backup run.
BACKUP_WEBHOOK_URL=
BACKUP_MINIO_ENABLED=true
# Set true to also run one backup immediately when the backup container starts
# (useful the first time you deploy, so you don't wait for the cron schedule).
BACKUP_RUN_ON_START=false
