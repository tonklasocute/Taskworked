# Local (non-Docker) dev — run `docker compose up postgres redis minio` then run this API with `go run ./cmd/api`
PORT=8080
DATABASE_URL=postgres://taskworked:change-me@localhost:5432/taskworked?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ANTHROPIC_API_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=taskworked
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
LINE_NOTIFY_TOKEN=
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1m
